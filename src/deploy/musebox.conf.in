# /etc/systemd/system/musegadget.service.d/musebox.conf
# Generated by musebox's install.sh from deploy/musebox.conf.in.
#
# Sandbox for the musebox gadget. The service runs as root (device keys) and
# drops to the `muse` account for file ops; both see only what's left here.
# fileops.py already confines paths to the box; this is the second fence.

[Service]
Environment=MUSEGADGET_RUN_AS=muse
Environment=MUSEBOX_ROOT=@BOX@
# Muse's files come out group-writable for musebox, so members can clean up.
UMask=0007

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@BOX@
TemporaryFileSystem=/mnt:ro /media:ro /opt:ro /srv:ro
BindPaths=@BOX@
BindReadOnlyPaths=/opt/musegadget
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# setuid/setgid to drop to muse; chown for the local socket's group.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN
