diff -ru -x __pycache__ /tmp/mg/linux/src/musegadget/fileops.py src/sdk/src/musegadget/fileops.py
--- /tmp/mg/linux/src/musegadget/fileops.py	2026-10-05 19:59:20.541532811 -0400
+++ src/sdk/src/musegadget/fileops.py	2026-10-05 19:59:30.356745867 -0400
@@ -32,12 +32,34 @@
 import sys
 
 MAX_CHUNK_BYTES = 64 * 1024
+# musebox fork: reads stay inside the box, writes inside a task's out/ dir.
+# MUSEBOX_ROOT comes from the service's unit (Executor passes it on); Muse
+# can't set it.
+DEFAULT_BOX = "/srv/musebox"
+BOX = os.path.realpath(os.environ.get("MUSEBOX_ROOT") or DEFAULT_BOX)
+TASKS = os.path.join(BOX, "tasks")
 
 
 class FileOpError(Exception):
     pass
 
 
+def _inside(path: str, root: str) -> bool:
+    return path == root or path.startswith(root + os.sep)
+
+
+def _confine(path: str, write: bool) -> str:
+    """Resolve symlinks and refuse anything outside the box (or out/ for writes)."""
+    real = os.path.realpath(path)
+    if not _inside(real, BOX):
+        raise FileOpError(f"only paths under {BOX} are allowed")
+    if write:
+        parts = os.path.relpath(real, TASKS).split(os.sep)
+        if parts[0] in (os.pardir, ".") or len(parts) < 3 or parts[1] != "out":
+            raise FileOpError(f"writes are allowed only under {TASKS}/<id>/out/")
+    return real
+
+
 def _partial_path(path: str) -> str:
     head, tail = os.path.split(path)
     return os.path.join(head, f".{tail}.musegadget-partial")
